{
  "name": "@survivor/mobile",
  "version": "2.0.5",
  "main": "expo-router/entry",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bash -c 'if [[ \"$1\" != \"-f\" ]]; then IP=$(ipconfig getifaddr en11 || ipconfig getifaddr en0) && sed -i \"\" \"s|^EXPO_PUBLIC_API_URL=.*|EXPO_PUBLIC_API_URL=http://$IP:1234|\" .env && echo \"Set EXPO_PUBLIC_API_URL to http://$IP:1234\"; else echo \"Using existing EXPO_PUBLIC_API_URL from .env\"; fi && expo start --clear' --",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:ios": "NODE_ENV=production npx expo prebuild --platform ios --clean",
    "web": "expo start --web",
    "deploy": "npx expo export -p web && npx eas-cli@latest deploy",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixall": "npm run format && npm run lint:fix",
    "icons": "node scripts/generateIcons.ts"
  },
  "dependencies": {
    "@clerk/expo": "^4.14.0",
    "@expo-google-fonts/roboto": "^0.4.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/blur": "^4.4.1",
    "@react-native-community/cli": "^20.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@shopify/react-native-skia": "2.14.0",
    "@survivor/copy": "*",
    "@survivor/lib": "*",
    "@survivor/tailwind-preset": "*",
    "@survivor/types": "*",
    "@tanstack/query-async-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "@uiw/color-convert": "^2.8.0",
    "clsx": "^2.1.1",
    "debug": "^4.4.3",
    "expo": "^58.0.16",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.3",
