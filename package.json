{
  "name": "trial-by-fire",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "cd apps/web && npm run dev",
    "mobile": "cd apps/mobile && npm run dev",
    "prebuild": "cd apps/mobile && npm run build:ios",
    "xcode": "xed aps/apps/mobile/ios",
    "db:studio": "cd apps/web && npm run db:studio",
    "db:push": "cd apps/web && npm run db:push",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "dependencies": {
    "expo": "~58.0.17",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "npm@10.5.0",
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "~19.3.0"
  },
  "version": "1.0.0",
  "allowScripts": {
    "@clerk/shared@3.48.0": true,
    "browser-tabs-lock@1.3.0": true,
    "core-js@3.47.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
