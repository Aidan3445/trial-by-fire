{
  "name": "trial-by-fire",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "turbo dev --filter=@survivor/web",
    "mobile": "turbo dev --filter=@survivor/mobile",
    "db:studio": "cd apps/web && npm run db:studio",
    "db:push": "cd apps/web && npm run db:push",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "postinstall": "cp -R apps/web/node_modules/@types/react node_modules/@types/react 2>/dev/null || true"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.5.0"
}
