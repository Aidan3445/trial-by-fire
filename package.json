{
  "name": "trial-by-fire",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "cd apps/web && npm run dev",
    "mobile": "cd apps/mobile && npm run dev",
    "db:studio": "cd apps/web && npm run db:studio",
    "db:push": "cd apps/web && npm run db:push",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.5.0"
}
